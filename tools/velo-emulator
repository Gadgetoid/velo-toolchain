#!/usr/bin/env python3
import argparse
import hashlib
import os
import shutil
import socket
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tests"))
import emulator

SH3_PORT = 2003
SH3_AGENT_SOCKET = "agent.sock"


def file_digest(path):
    with open(path, "rb") as file:
        return hashlib.sha256(file.read()).hexdigest()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Start velo-emu, or the SH3 emulator, from the debug desktop state, with its GDB stub listening")
    parser.add_argument("--ce", choices=["1", "2"], default="1")
    parser.add_argument("--arch", choices=["mips", "sh3"], default="mips", help="sh3: the SH3 emulator (VELO_SH3_EMU, VELO_SH3_ROM), CE 2.12")
    parser.add_argument("--gdb", type=int, help="GDB port, default 2001 for CE 1.0, 2002 for CE 2.0 and 2003 for SH3")
    parser.add_argument("--headless", action="store_true", help="no window: run until GDB detaches")
    arguments = parser.parse_args()
    sh3 = arguments.arch == "sh3"
    port = arguments.gdb or (SH3_PORT if sh3 else 2000 + int(arguments.ce))
    if sh3:
        print("velo-emulator: starting SH3 CE 2.12 on GDB port %d" % port, flush=True)
    else:
        print("velo-emulator: starting CE %s.0 on GDB port %d" % (arguments.ce, port), flush=True)
    probe = socket.socket()
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        probe.bind(("127.0.0.1", port))
    except OSError:
        print("gdb: listening on 127.0.0.1:%d (already running)" % port, flush=True)
        sys.exit(0)
    finally:
        probe.close()
    states = os.path.join(ROOT, "build", "debugmgr", "ce2-sh3" if sh3 else "ce" + arguments.ce)
    state = os.path.join(states, "debug-desktop.state")
    if not os.path.exists(state):
        sys.exit("velo-emulator: error: no %s; run make %s in %s" % (state, "debug-state-sh3" if sh3 else "debug-state", ROOT))
    target = emulator.TARGETS[emulator.target_name(arguments.ce, arguments.arch)]
    rom = target["rom"]()
    if os.path.exists(state + ".rom"):
        expected_digest, expected_rom = open(state + ".rom").read().strip().split(" ", 1)
        if file_digest(rom) != expected_digest:
            setting = "VELO_SH3_ROM" if sh3 else "VELO_EMU's rom/nk.bin" if arguments.ce == "1" else "VELO_CE%s_ROM" % arguments.ce
            sys.exit("velo-emulator: error: the debug state was made with %s, but %s is %s; set it to that ROM, or run make %s with this one"
                     % (expected_rom, setting, rom, "debug-state-sh3" if sh3 else "debug-state"))
    symbols_setting = "VELO_SH3_OS_SYMBOLS" if sh3 else "VELO_OS_SYMBOLS"
    symbols = emulator.optional_environment(symbols_setting)
    if symbols and os.path.exists(os.path.join(symbols, "rom.sha256")):
        if open(os.path.join(symbols, "rom.sha256")).read().split()[0] != file_digest(rom):
            print("velo-emulator: warning: %s is for another ROM than %s" % (symbols_setting, rom), flush=True)
    session = os.path.join(states, "session.state")
    shutil.copyfile(state, session)
    folder = target["emulator"]() if sh3 else emulator.environment("VELO_EMU")
    extra = ["--agent=%s" % os.path.join(states, SH3_AGENT_SOCKET)] if sh3 else []
    if arguments.headless:
        command = [os.path.join(folder, "headless"), rom, "--load=%s" % session, "--gdb=%d" % port, *extra]
    else:
        command = [os.path.join(folder, "sh3emu" if sh3 else "velo"), "--state=%s" % session, "--gdb=%d" % port, *extra, rom]
    os.execv(command[0], command)
