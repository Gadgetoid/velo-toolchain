{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "velo: emulator CE 1.0",
            "type": "process",
            "command": "${env:VELO_TOOLCHAIN}/tools/velo-emulator",
            "args": [
                "--ce",
                "1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "velo",
                "pattern": {
                    "regexp": "^velo-emulator: error: (.*)$",
                    "message": 1
                },
                "background": {
                    "activelyMatching": true,
                    "beginsPattern": "^velo-emulator: starting",
                    "endsPattern": "^gdb: listening on "
                }
            }
        },
        {
            "label": "velo: emulator CE 2.0",
            "type": "process",
            "command": "${env:VELO_TOOLCHAIN}/tools/velo-emulator",
            "args": [
                "--ce",
                "2"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "velo",
                "pattern": {
                    "regexp": "^velo-emulator: error: (.*)$",
                    "message": 1
                },
                "background": {
                    "activelyMatching": true,
                    "beginsPattern": "^velo-emulator: starting",
                    "endsPattern": "^gdb: listening on "
                }
            }
        }
    ]
}
